<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.oneplane.favorites.dao.FavoritesCountryDao">

    <resultMap id="FavoritesCountryMap" type="com.oneplane.favorites.domain.FavoritesCountry">
        <id property="favoritesCountryId" column="favorites_country_id"/>
        <result property="countryId" column="country_id"/>
        <result property="userId" column="user_id"/>

        <!-- Country 객체 매핑 -->
        <association property="country" javaType="com.oneplane.country.domain.Country">
            <id property="countryId" column="c_country_id"/>
            <result property="countryName" column="country_name"/>
            <result property="countryEnName" column="country_en_name"/>
            <result property="isoCode" column="iso_code"/>
            <result property="continent" column="continent"/>
            <result property="img" column="img"/>
            <result property="latitude" column="latitude"/>
            <result property="longitude" column="longitude"/>
            <result property="currency" column="currency"/>
            <result property="distance" column="distance"/>
        </association>
    </resultMap>

    <insert id="insertFavorites" parameterType="com.oneplane.favorites.domain.FavoritesCountry">
        INSERT INTO favorites_country (favorites_country_id, country_id, user_id)
        VALUES (seq_favorites_country.NEXTVAL, #{countryId}, #{userId})
    </insert>

    <delete id="deleteFavorites" parameterType="long">
        DELETE FROM favorites_country WHERE favorites_country_id = #{favoritesCountryId}
    </delete>

    <select id="selectFavoritesByUser" parameterType="long" resultMap="FavoritesCountryMap">
        SELECT
        f.favorites_country_id,
        f.country_id,
        f.user_id,
        c.country_id AS c_country_id,
        c.country_name,
        c.country_en_name,
        c.iso_code,
        c.continent,
        c.img,
        c.latitude,
        c.longitude,
        c.currency,
        c.distance
        FROM favorites_country f
        JOIN country c ON f.country_id = c.country_id
        WHERE f.user_id = #{userId}
        ORDER BY f.favorites_country_id
    </select>

</mapper>
