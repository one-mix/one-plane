<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.oneplane.country.repository.CountryRepository">

    <!-- iso_code를 기준으로 countryId 조회 -->
    <select id="findCountryIdByIsoCode" resultType="java.lang.Integer" parameterType="java.lang.String">
        SELECT country_id
        FROM country
        WHERE iso_code = #{isoCode}
    </select>

</mapper>