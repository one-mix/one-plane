<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.oneplane.alert.dao.AlertLevelDao">

    <!-- AlertLevel + Country 조인 -->
    <select id="selectAllAlerts" resultMap="AlertWithCountryMap">
        SELECT
        a.alert_id,
        a.country_id,
        a.level_value,
        c.country_id       AS c_id,
        c.country_name     AS c_name,
        c.country_en_name  AS c_en_name,
        c.iso_code         AS c_iso,
        c.continent        AS c_continent,
        c.img              AS c_img
        FROM alert_level a
        JOIN country c ON a.country_id = c.country_id
    </select>

    <!-- resultMap 정의 -->
    <resultMap id="AlertWithCountryMap" type="com.oneplane.alert.domain.AlertLevel">
        <id property="alertId" column="alert_id"/>
        <result property="countryId" column="country_id"/>
        <result property="levelValue" column="level_value"/>

        <association property="country" javaType="com.oneplane.country.domain.Country">
            <id property="countryId" column="c_id"/>
            <result property="countryName" column="c_name"/>
            <result property="countryEnName" column="c_en_name"/>
            <result property="isoCode" column="c_iso"/>
            <result property="continent" column="c_continent"/>
            <result property="img" column="c_img"/>
        </association>
    </resultMap>

    <!-- iso_code로 countryId 조회 -->
    <select id="findCountryIdByIsoCode" resultType="java.lang.Long" parameterType="java.lang.String">
        SELECT country_id
        FROM country
        WHERE iso_code = #{isoCode}
    </select>

    <!-- update -->
    <update id="updateAlertLevel" parameterType="com.oneplane.alert.dto.AlertLevelDTO">
        UPDATE alert_level
        SET level_value = #{levelValue}
        WHERE country_id = #{countryId}
    </update>

    <!-- country_id 존재 여부 -->
    <select id="existsByCountryId" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        SELECT COUNT(*)
        FROM alert_level
        WHERE country_id = #{countryId}
    </select>

    <!-- insert -->
    <insert id="insertAlertLevel" parameterType="com.oneplane.alert.dto.AlertLevelDTO">
        INSERT INTO alert_level (country_id, level_value)
        VALUES (#{countryId}, #{levelValue})
    </insert>

</mapper>
