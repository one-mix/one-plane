<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성자: 김동현 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.oneplane.post.mapper.PostLikeMapper">

    <resultMap id="PostLikeResultMap" type="com.oneplane.post.domain.PostLike">
        <id property="postLikeId" column="post_like_id"/>
        <result property="userId" column="user_id"/>
        <result property="postId" column="post_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="userName" column="user_name"/>
        <result property="userNickname" column="user_nickname"/>
        <result property="postTitle" column="post_title"/>
    </resultMap>

    <insert id="insertPostLike" parameterType="com.oneplane.post.domain.PostLike"
            useGeneratedKeys="true" keyProperty="postLikeId" keyColumn="post_like_id">
        INSERT INTO post_like (
            post_like_id, user_id, post_id, created_at
        ) VALUES (
                     post_like_seq.NEXTVAL, #{userId}, #{postId}, SYSDATE
                 )
    </insert>

    <!-- 좋아요 취소 -->
    <delete id="deletePostLike">
        DELETE FROM post_like
        WHERE user_id = #{userId}
          AND post_id = #{postId}
    </delete>

    <!-- 좋아요 존재 확인 -->
    <select id="existsPostLike" resultType="int">
        SELECT COUNT(*)
        FROM post_like
        WHERE user_id = #{userId}
          AND post_id = #{postId}
    </select>

    <!-- 게시글의 총 좋아요 수 조회 -->
    <select id="countPostLikes" parameterType="Integer" resultType="int">
        SELECT COUNT(*)
        FROM post_like
        WHERE post_id = #{postId}
    </select>

    <!-- 특정 게시글의 좋아요 목록 조회 (최근 순) -->
    <select id="findPostLikesByPostId" resultMap="PostLikeResultMap">
        <![CDATA[
        SELECT * FROM (
                          SELECT
                              pl.post_like_id,
                              pl.user_id,
                              pl.post_id,
                              pl.created_at,
                              u.name as user_name,
                              u.nickname as user_nickname
                          FROM post_like pl
                                   LEFT JOIN users u ON pl.user_id = u.user_id
                          WHERE pl.post_id = #{postId}
                          ORDER BY pl.created_at DESC
                      )
        WHERE ROWNUM <= #{limit}
        ]]>
    </select>

    <!-- 특정 사용자가 좋아요한 게시글 목록 조회 -->
    <select id="findPostLikesByUserId" resultMap="PostLikeResultMap">
        <![CDATA[
        SELECT * FROM (
                          SELECT ROWNUM rn, a.* FROM (
                                                         SELECT
                                                             pl.post_like_id,
                                                             pl.user_id,
                                                             pl.post_id,
                                                             pl.created_at,
                                                             p.title as post_title
                                                         FROM post_like pl
                                                                  LEFT JOIN posts p ON pl.post_id = p.post_id
                                                         WHERE pl.user_id = #{userId}
                                                           AND p.deleted_at IS NULL
                                                         ORDER BY pl.created_at DESC
                                                     ) a
                          WHERE ROWNUM <= #{offset} + #{size}
                      )
        WHERE rn > #{offset}
        ]]>
    </select>

    <!-- 특정 사용자가 좋아요한 게시글 수 조회 -->
    <select id="countPostLikesByUserId" parameterType="Integer" resultType="int">
        SELECT COUNT(*)
        FROM post_like pl
                 LEFT JOIN posts p ON pl.post_id = p.post_id
        WHERE pl.user_id = #{userId}
          AND p.deleted_at IS NULL
    </select>

    <!-- 전체 좋아요 수 조회 -->
    <select id="countAllPostLikes" resultType="int">
        SELECT COUNT(*)
        FROM post_like
    </select>

    <!-- 오늘 작성된 좋아요 수 -->
    <select id="countTodayPostLikes" resultType="int">
    <![CDATA[
        SELECT COUNT(*)
        FROM post_like
        WHERE created_at >= TRUNC(SYSDATE)
          AND created_at < TRUNC(SYSDATE) + 1
        ]]>
</select>

</mapper>