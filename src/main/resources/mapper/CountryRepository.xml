<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.oneplane.country.repository.CountryRepository">

    <select id="findCountryIdByIsoCode" resultType="java.lang.Integer" parameterType="string">
        SELECT country_id
        FROM country
        WHERE iso_code = #{isoCode}
    </select>

    <select id="findCountryInfo" parameterType="string" resultType="com.oneplane.recommend.dto.RecommendResultDTO">
        SELECT continent,
        img AS countryImg
        FROM country
        WHERE iso_code = #{isoCode}
    </select>

</mapper>
